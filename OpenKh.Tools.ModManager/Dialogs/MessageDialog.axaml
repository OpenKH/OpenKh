        <StreamGeometry x:Key="icon_type_error">M12 2C17.5228 2 22 6.47715 22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2ZM11.999 14.502C11.4475 14.502 11 14.9494 11 15.501C11 16.0525 11.4475 16.5 11.999 16.5C12.5504 16.4998 12.997 16.0524 12.9971 15.501C12.9971 14.9496 12.5504 14.5021 11.999 14.502ZM11.9941 7C11.5801 7.00051 11.2448 7.33687 11.2451 7.75098L11.249 12.252L11.2559 12.3535C11.3058 12.7195 11.6194 13.0021 11.999 13.002C12.4132 13.0016 12.7494 12.6652 12.749 12.251L12.7451 7.74902L12.7383 7.64746C12.6883 7.2815 12.3738 6.9997 11.9941 7Z</StreamGeometry>
    </Window.Resources>

    <StackPanel Margin="15" Spacing="10">
        <StackPanel Orientation="Horizontal" Spacing="5">
            <PathIcon  Name="MainIcon" Data="{StaticResource icon_type_info}" VerticalAlignment="Top"/>
            <TextBlock Name="MainText" TextWrapping="Wrap" VerticalAlignment="Center" Text="Ayy man this shit be spewin' sum' BULLSHIT!"/>
        </StackPanel>
        <Button Name="AcceptButton" HorizontalAlignment="Right" HorizontalContentAlignment="Center" Content="OK" Click="OnAcceptClicked" Width="50" HotKey="Enter"/>
    </StackPanel>
</Window>
