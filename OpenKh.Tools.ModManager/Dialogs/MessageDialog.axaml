        mc:Ignorable="d" x:Class="OpenKh.Tools.ModManager.Dialogs.MessageDialog"
        Title="Some Message Title" SizeToContent="WidthAndHeight" CanResize="False" WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <StreamGeometry x:Key="icon_type_info">M12.0016 1.99902C17.5253 1.99902 22.0031 6.47687 22.0031 12.0006C22.0031 17.5243 17.5253 22.0021 12.0016 22.0021C6.47785 22.0021 2 17.5243 2 12.0006C2 6.47687 6.47785 1.99902 12.0016 1.99902ZM12 10.5C11.5858 10.5 11.25 10.8358 11.25 11.25V16.25C11.25 16.6642 11.5858 17 12 17C12.4142 17 12.75 16.6642 12.75 16.25V11.25C12.75 10.8358 12.4142 10.5 12 10.5ZM12 9C12.5523 9 13 8.55228 13 8C13 7.44772 12.5523 7 12 7C11.4477 7 11 7.44772 11 8C11 8.55228 11.4477 9 12 9Z</StreamGeometry>
