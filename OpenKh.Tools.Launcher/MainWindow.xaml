<Window x:Class="OpenKh.Tools.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="OpenKH Launcher"
        Width="920"
        Height="620"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#0D1420"
        Foreground="#F5F7FB"
        Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#AAB5C6"/>
        <SolidColorBrush x:Key="CardBrush" Color="#172131"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#2A3850"/>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#3978E6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="20,11"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#4A89F7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#27364D"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" BorderBrush="#3D506E" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#324562"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F5F7FB"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="32,22" Background="#111B29" BorderBrush="#26354A" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Width="210" Height="64" HorizontalAlignment="Left" Source="Assets/OpenKH.png" Stretch="Uniform"/>
                <TextBlock Grid.Column="1" Text="LAUNCHER" Foreground="#7890B1" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="32,28">
            <Grid x:Name="HomePanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="What would you like to do?" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Margin="0,7,0,0" Text="Choose the Mod Manager to play with mods, or open the creator tools when you need them." Foreground="{StaticResource MutedTextBrush}" FontSize="14"/>
                </StackPanel>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Padding="28" Background="{StaticResource CardBrush}" BorderBrush="#3978E6" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <Border HorizontalAlignment="Left" Padding="9,4" Background="#193C73" CornerRadius="10">
                                    <TextBlock Text="RECOMMENDED" Foreground="#9EC5FF" FontSize="10" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Margin="0,18,0,0" Text="Play with mods" FontSize="23" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,10,0,0" Text="Install, enable, update, and launch game mods from the OpenKH Mod Manager." Foreground="{StaticResource MutedTextBrush}" FontSize="14" TextWrapping="Wrap" LineHeight="21"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2">
                                <Button x:Name="LaunchModManagerButton" Style="{StaticResource PrimaryButton}" Content="Open Mod Manager" Click="LaunchModManager_Click"/>
                                <Button x:Name="CreateShortcutButton" Margin="0,8,0,0" Style="{StaticResource SecondaryButton}" Padding="15,7" Content="Create Desktop Shortcut" Click="CreateShortcut_Click"/>
                                <TextBlock x:Name="ModManagerStatusText" Margin="0,9,0,0" Foreground="#EE8989" FontSize="12" TextAlignment="Center" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Padding="28" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <Border HorizontalAlignment="Left" Padding="9,4" Background="#342D59" CornerRadius="10">
                                    <TextBlock Text="FOR MOD CREATORS" Foreground="#C8B8FF" FontSize="10" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Margin="0,18,0,0" Text="Create and inspect mods" FontSize="23" FontWeight="SemiBold"/>
                                <TextBlock Margin="0,10,0,0" Text="Browse editors, viewers, map studios, and other specialized OpenKH utilities." Foreground="{StaticResource MutedTextBrush}" FontSize="14" TextWrapping="Wrap" LineHeight="21"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2">
                                <Button Style="{StaticResource SecondaryButton}" Content="Browse Modding Tools" Click="ShowTools_Click"/>
                                <TextBlock x:Name="ToolCountText" Margin="0,9,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <Grid x:Name="ToolsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource SecondaryButton}" Content="← Back" Click="ShowHome_Click"/>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Modding Tools" FontSize="26" FontWeight="SemiBold"/>
                        <TextBlock Text="Specialized utilities for creating and inspecting game content." Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Grid.Column="0" Height="40" Padding="12,8" Background="#111B29" Foreground="#F5F7FB" BorderBrush="#334661" BorderThickness="1" FontSize="14" TextChanged="SearchBox_TextChanged"/>
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Open Apps Folder" Click="OpenToolsFolder_Click"/>
                </Grid>

                <Border Grid.Row="4" Background="#111B29" BorderBrush="#26374E" BorderThickness="1" CornerRadius="8">
                    <ListBox x:Name="ToolsList" Background="Transparent" BorderThickness="0" Padding="7" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="ToolsList_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,5"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="14,11" Background="#182435" CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="32" Height="32" HorizontalAlignment="Left" Background="#2A4163" CornerRadius="16">
                                            <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#9EC5FF"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="#F5F7FB" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Margin="0,3,0,0" Text="{Binding Description}" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Width="38"
                                                Height="38"
                                                Margin="12,0,0,0"
                                                Padding="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                FontFamily="Segoe UI Symbol"
                                                FontSize="22"
                                                Content="{Binding FavoriteSymbol}"
                                                ToolTip="{Binding FavoriteAction}"
                                                AutomationProperties.Name="{Binding FavoriteAction}"
                                                Tag="{Binding}"
                                                Click="ToggleFavorite_Click">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Foreground" Value="#93A2B8"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                                            <Setter Property="Foreground" Value="#FFD166"/>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="#FFE29A"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Grid.Column="3" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}" Padding="15,7" Content="Open" Tag="{Binding}" Click="LaunchTool_Click"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <TextBlock x:Name="ToolsStatusText" Grid.Row="6" Foreground="{StaticResource MutedTextBrush}"/>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Padding="32,14" Background="#0A101A" BorderBrush="#26354A" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="OpenKH" Foreground="#718099" FontSize="12"/>
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="CheckForUpdatesButton" Padding="0" Margin="0,0,20,0" Background="Transparent" BorderThickness="0" Foreground="#8FB9F8" Content="Check for Updates" Cursor="Hand" Click="CheckForUpdates_Click"/>
                    <Button Padding="0" Margin="0,0,20,0" Background="Transparent" BorderThickness="0" Foreground="#8FB9F8" Content="Documentation" Cursor="Hand" Click="OpenDocumentation_Click"/>
                    <TextBlock x:Name="VersionText" Foreground="#718099" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
