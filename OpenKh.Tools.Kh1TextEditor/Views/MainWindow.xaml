<Window x:Class="OpenKh.Tools.Kh1TextEditor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KH1 Text editor - OpenKH" Height="680" Width="1080"
        MinHeight="480" MinWidth="760"
        Closing="Window_Closing">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Open" Executed="OpenBinl_Executed"/>
        <CommandBinding Command="ApplicationCommands.Save" Executed="Save_Executed"/>
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="ApplicationCommands.Open"/>
        <KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save"/>
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open BINL..." Command="ApplicationCommands.Open"/>
                <Separator/>
                <MenuItem Header="_Save" Command="ApplicationCommands.Save"/>
                <MenuItem Header="Save _as..." Click="SaveAs_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="240"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="SearchBox" Margin="0,0,0,8" Padding="6,4"
                         ToolTip="Search text" TextChanged="SearchBox_TextChanged"/>
                <ListBox x:Name="EntryList" Grid.Row="1" ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,4" ToolTip="{Binding Text}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Number}" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="1" Text="{Binding Offset}" Foreground="Gray"/>
                                <TextBlock Grid.Column="2" Text="{Binding Preview}"
                                           TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

            <Grid Grid.Column="2" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="{Binding SelectedEntry.Number}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding SelectedEntry.Offset}" Margin="12,2,0,0" Foreground="Gray"/>
                </DockPanel>
                <TextBox Grid.Row="1" Text="{Binding SelectedEntry.Text, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         IsEnabled="{Binding HasSelection}" Padding="8"
                         FontFamily="Consolas" FontSize="15" SpellCheck.IsEnabled="False"/>
                <Border Grid.Row="2" Margin="0,8,0,0" Padding="8" Background="#10000000">
                    <TextBlock TextWrapping="Wrap">
                        Space = 01 · New line = 02 · {eol} = 00. Keep {cmd:...} formatting tokens intact.
                    </TextBlock>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
