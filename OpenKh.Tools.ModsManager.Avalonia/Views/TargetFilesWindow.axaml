<views:EmbeddedDialogControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:OpenKh.Tools.ModsManager.Avalonia.Views"
        x:Class="OpenKh.Tools.ModsManager.Avalonia.Views.TargetFilesWindow"
        XYFocus.NavigationModes="Enabled">
  <Grid Margin="28" RowDefinitions="Auto,16,Auto,16,*,16,Auto">
    <StackPanel Spacing="5">
      <TextBlock Text="Select Target Files" FontSize="27" FontWeight="Bold" />
      <TextBlock Text="Selected files will be copied into the mod and appended to mod.yml."
                 Foreground="#AAB9CF" TextWrapping="Wrap" />
    </StackPanel>
    <Grid Grid.Row="2" ColumnDefinitions="*,12,130">
      <TextBox x:Name="SearchTextBox" PlaceholderText="Search by relative path" />
      <Button x:Name="SearchButton" Grid.Column="2" Content="Search" Click="Search_OnClick" />
    </Grid>
    <Border Grid.Row="4" Classes="settings-card">
      <Grid RowDefinitions="*,12,Auto">
        <ListBox x:Name="FilesListBox" SelectionMode="Multiple" />
        <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="#91A2BA" TextWrapping="Wrap" />
      </Grid>
    </Border>
    <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
      <Button x:Name="CancelButton" Content="Cancel" MinWidth="120" Click="Cancel_OnClick" />
      <Button x:Name="AppendButton" Classes="primary" Content="Append Selected" MinWidth="160" Click="Append_OnClick" />
    </StackPanel>
  </Grid>
</views:EmbeddedDialogControl>
