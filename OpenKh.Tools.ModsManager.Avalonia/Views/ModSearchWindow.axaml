<common:DialogWindowBase
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="using:OpenKh.Tools.Common.Avalonia"
        x:Class="OpenKh.Tools.ModsManager.Views.ModSearchWindow"
        Title="Online Mods" Height="500" Width="800"
        WindowStartupLocation="CenterOwner" Background="{Binding ColorTheme.BackgroundColor}">
    <Grid Margin="10" RowDefinitions="Auto,*">

        <!-- Header with title and search -->
        <Grid Grid.Row="0" Margin="0 0 0 10" RowDefinitions="Auto,Auto">
            <TextBlock Grid.Row="0" Text="Available Online Mods" FontSize="18" FontWeight="Bold"
                       Foreground="{Binding ColorTheme.TextColor}" VerticalAlignment="Center"/>

            <!-- Search box -->
            <Grid Grid.Row="1" Margin="0,10,0,0" ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" x:Name="SearchBox" Padding="5,3"
                         Text="{Binding SearchQuery}"
                         Watermark="Search by name or description..."
                         VerticalContentAlignment="Center"
                         Foreground="{Binding ColorTheme.TextColor}"/>
                <Button Grid.Column="1" Content="Clear" Width="60" Margin="5,0,0,0"
                        Command="{Binding ClearSearchCommand}"
                        IsVisible="{Binding HasSearchQuery}"/>
            </Grid>
        </Grid>

        <!-- Main content with mods list and details -->
        <Grid Grid.Row="1" ColumnDefinitions="*,10,300">

            <!-- Mods list with top info bars including loading indicator -->
            <Grid Grid.Column="0">
                <DockPanel LastChildFill="True">
                    <!-- Loading indicator -->
                    <Grid Background="#DD000000" IsVisible="{Binding IsLoading}" DockPanel.Dock="Top">
                        <Border BorderBrush="#888888" BorderThickness="2">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="2">
                                <TextBlock Text="Loading mods..." FontSize="18" Foreground="White" HorizontalAlignment="Center" FontWeight="Bold"/>
                                <TextBlock Text="{Binding LoadingStatusText}" FontSize="14" Foreground="White" HorizontalAlignment="Center" Margin="0,2,0,2" TextWrapping="Wrap" TextAlignment="Center"/>
                                <ProgressBar IsIndeterminate="True" Height="10" Width="250" Margin="0,2,0,2"/>
                                <Button HorizontalAlignment="Center" Margin="0,5,0,0" Command="{Binding CancelCommand}">Cancel</Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Local log messages -->
                    <Grid Background="#DD000000" IsVisible="{Binding HasLog}" DockPanel.Dock="Top">
                        <Border BorderBrush="#888888" BorderThickness="2">
                            <DockPanel LastChildFill="True" Margin="3">
                                <Button Command="{Binding ClearLog}" DockPanel.Dock="Right" Margin="3,0">Clear</Button>
                                <Button Command="{Binding ShowLog}" DockPanel.Dock="Right" Margin="3,0">Show last 100</Button>
                                <Button Command="{Binding CopyLog}" DockPanel.Dock="Right" Margin="3,0">Copy to clipboard</Button>
                                <TextBlock Foreground="White">
                                    <Run>Has </Run>
                                    <Run Text="{Binding NumMessages}"/>
                                    <Run> messages</Run>
                                </TextBlock>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <Grid>
                        <ScrollViewer>
                            <ItemsControl ItemsSource="{Binding FilteredMods}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,5" Padding="10" Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                                                CornerRadius="5" Cursor="Hand" PointerPressed="Mod_PointerPressed">
                                            <Grid ColumnDefinitions="64,*,Auto">

                                                <!-- Mod icon -->
                                                <Image Grid.Column="0" Width="64" Height="64" Source="{Binding IconImage}" Margin="0,0,10,0"/>

                                                <!-- Mod info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="14"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{Binding $parent[Window].DataContext.ColorTheme.TextColor}"/>
                                                    <TextBlock Text="{Binding Author}" FontSize="12" Opacity="0.7"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{Binding $parent[Window].DataContext.ColorTheme.TextColor}"/>
                                                    <TextBlock Text="{Binding Description}" FontSize="12" TextWrapping="Wrap" MaxHeight="40"
                                                               TextTrimming="CharacterEllipsis" Margin="0,5,0,0"
                                                               Foreground="{Binding $parent[Window].DataContext.ColorTheme.TextColor}"/>
                                                </StackPanel>

                                                <!-- Install button -->
                                                <Button Grid.Column="2" Content="Install" Command="{Binding InstallCommand}"
                                                        Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center" MinWidth="70" Height="28"
                                                        IsEnabled="{Binding !IsInstalling}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <!-- Empty list message -->
                        <TextBlock Text="No mods available for this game"
                                   IsVisible="{Binding HasNoMods}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"
                                   Foreground="{Binding ColorTheme.TextColor}"/>
                    </Grid>
                </DockPanel>
            </Grid>

            <!-- Mod details panel -->
            <Border Grid.Column="2" Background="#22FFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="5" Padding="10">
                <ScrollViewer>
                    <StackPanel>
                        <!-- Selected mod details -->
                        <Grid IsVisible="{Binding HasSelectedMod}">
                            <StackPanel>
                                <!-- Preview image -->
                                <Border Height="150" Margin="0,0,0,10" Background="#11FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1">
                                    <Image Source="{Binding SelectedMod.ScreenshotImage}" Stretch="Uniform"/>
                                </Border>

                                <!-- Details -->
                                <TextBlock Text="{Binding SelectedMod.Title}" FontWeight="Bold" FontSize="18"
                                           TextWrapping="Wrap" Margin="0,0,0,5"
                                           Foreground="{Binding ColorTheme.TextColor}"/>

                                <TextBlock Text="{Binding SelectedMod.Author, StringFormat='Author: {0}'}" FontSize="14"
                                           Margin="0,0,0,10" Foreground="{Binding ColorTheme.TextColor}"/>

                                <TextBlock Text="Description:" FontWeight="Bold" Foreground="{Binding ColorTheme.TextColor}"/>
                                <TextBlock Text="{Binding SelectedMod.Description}" TextWrapping="Wrap" Margin="0,5,0,10"
                                           Foreground="{Binding ColorTheme.TextColor}"/>

                                <!-- Repository link -->
                                <TextBlock Text="Repository:" FontWeight="Bold" Foreground="{Binding ColorTheme.TextColor}"/>
                                <TextBlock Margin="0,5,0,0" Text="{Binding SelectedMod.Repo}" TextWrapping="Wrap"
                                           Foreground="#569CD6" Cursor="Hand"
                                           Tag="{Binding SelectedMod.RepoUrl}" PointerReleased="Link_PointerReleased"/>
                            </StackPanel>
                        </Grid>

                        <!-- No selection message -->
                        <TextBlock Text="Select a mod to view details"
                                   IsVisible="{Binding !HasSelectedMod}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{Binding ColorTheme.TextColor}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</common:DialogWindowBase>
