<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenKh.Tools.ModsManager.Views.CollectionOptionalModDetailsView">
    <StackPanel>
        <TextBlock Margin="3 0 0 3" FontWeight="Bold" Text="{Binding Name}"/>
        <TextBlock Margin="3 0 0 3" Text="{Binding Author}"/>
    </StackPanel>
</UserControl>
