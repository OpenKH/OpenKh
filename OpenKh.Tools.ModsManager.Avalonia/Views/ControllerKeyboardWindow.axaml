<views:EmbeddedDialogControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:OpenKh.Tools.ModsManager.Avalonia.Views"
        x:Class="OpenKh.Tools.ModsManager.Avalonia.Views.ControllerKeyboardWindow"
        XYFocus.NavigationModes="Enabled">
  <Grid Margin="28" RowDefinitions="Auto,14,Auto,18,*,14,Auto">
    <StackPanel Spacing="5">
      <TextBlock Text="Enter Text" FontSize="27" FontWeight="Bold" />
      <TextBlock Text="Use the controller to enter text in the selected field."
                 Foreground="#AAB9CF" TextWrapping="Wrap" />
    </StackPanel>

    <Border Grid.Row="2" Classes="settings-card" Padding="16">
      <TextBlock x:Name="InputPreview" FontSize="18" TextWrapping="NoWrap"
                 TextTrimming="CharacterEllipsis" />
    </Border>

    <StackPanel x:Name="KeyboardRows" Grid.Row="4" Spacing="6"
                HorizontalAlignment="Center" VerticalAlignment="Center" />

    <TextBlock Grid.Row="6"
               Text="D-pad or left stick: move   A or Cross: type   X or Square: backspace   Y or Triangle: shift   B or Circle: close"
               Foreground="#71839E" FontSize="11" HorizontalAlignment="Center" />
  </Grid>
</views:EmbeddedDialogControl>
