<views:EmbeddedDialogControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:OpenKh.Tools.ModsManager.Avalonia.Views"
        x:Class="OpenKh.Tools.ModsManager.Avalonia.Views.OnlineModsWindow"
        XYFocus.NavigationModes="Enabled">
  <Grid Margin="24" RowDefinitions="Auto,14,Auto,14,*,14,Auto">
    <StackPanel Spacing="5">
      <TextBlock Text="Browse Mods" FontSize="28" FontWeight="Bold" />
      <TextBlock x:Name="GameHelpText" Foreground="#AAB9CF" />
    </StackPanel>

    <TextBox x:Name="SearchTextBox" Grid.Row="2"
             PlaceholderText="Search by name, author, description, or repository"
             TextChanged="Search_OnTextChanged" />

    <Grid Grid.Row="4" ColumnDefinitions="3*,14,2*">
      <Border Classes="online-mod-panel" Padding="8">
        <ListBox x:Name="ModsList" SelectionChanged="ModsList_OnSelectionChanged"
                 GotFocus="ModsList_OnGotFocus" Background="Transparent">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Width" Value="190" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="5" />
            </Style>
            <Style Selector="ListBoxItem /template/ ContentPresenter">
              <Setter Property="Background" Value="#101E32" />
              <Setter Property="BorderBrush" Value="#203550" />
              <Setter Property="BorderThickness" Value="1" />
              <Setter Property="CornerRadius" Value="10" />
            </Style>
            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
              <Setter Property="Background" Value="#132A49" />
              <Setter Property="BorderBrush" Value="#397FFF" />
              <Setter Property="BorderThickness" Value="2" />
            </Style>
            <Style Selector="ListBoxItem:focus-visible /template/ ContentPresenter">
              <Setter Property="Background" Value="#132A49" />
              <Setter Property="BorderBrush" Value="#8DB5FF" />
              <Setter Property="BorderThickness" Value="3" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="10" Spacing="8">
                <Border Height="86" CornerRadius="8" Background="#0B1728" ClipToBounds="True">
                  <Image Source="{Binding PreviewImage}" Stretch="UniformToFill" />
                </Border>
                <Grid ColumnDefinitions="38,*">
                  <Border Width="32" Height="32" CornerRadius="8" Background="#203A62" ClipToBounds="True">
                    <Grid>
                      <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 FontWeight="Bold" Foreground="#8DB7FF" />
                      <Image Source="{Binding IconImage}" Stretch="UniformToFill" />
                    </Grid>
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Author}" Foreground="#91A2BA" FontSize="10" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </Grid>
                <TextBlock Text="Select to view details" Foreground="#6F83A0" FontSize="9" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Border>

      <Border Grid.Column="2" Classes="online-mod-panel" Padding="20">
        <Grid RowDefinitions="*,Auto">
          <ScrollViewer>
            <StackPanel Spacing="12">
              <Border Background="#111C2E" CornerRadius="12" ClipToBounds="True">
                <Image x:Name="SelectedPreviewImage" MaxHeight="220" Stretch="Uniform" />
              </Border>
              <TextBlock x:Name="SelectedTitleText" FontSize="22" FontWeight="Bold" TextWrapping="Wrap" />
              <TextBlock x:Name="SelectedAuthorText" Foreground="#91A2BA" />
              <TextBlock x:Name="SelectedDescriptionText" TextWrapping="Wrap" Foreground="#C4D0E1" />
              <Border Background="#111C2E" CornerRadius="10" Padding="12">
                <TextBlock x:Name="SelectedRepositoryText" Foreground="#91A2BA" TextWrapping="Wrap" />
              </Border>
            </StackPanel>
          </ScrollViewer>
          <Button x:Name="InstallSelectedButton" Grid.Row="1" Classes="primary"
                  Content="Install Selected Mod" Click="InstallSelected_OnClick" HorizontalAlignment="Stretch" />
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="6" ColumnDefinitions="*,16,Auto">
      <Border Background="#111C2E" CornerRadius="10" Padding="12,9">
        <StackPanel Spacing="7">
          <ProgressBar x:Name="LoadingProgressBar" Minimum="0" Maximum="1"
                       Height="10" IsVisible="False" />
          <TextBlock x:Name="StatusText" Foreground="#C4D0E1"
                     FontWeight="SemiBold" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <Button x:Name="CloseButton" Grid.Column="2" Content="Close" Click="Close_OnClick" />
    </Grid>
  </Grid>
</views:EmbeddedDialogControl>
