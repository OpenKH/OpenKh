<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenKh.Tools.ModsManager.Views.WorkInProgressWindow"
        Title="{Binding DialogTitle}" Height="120" Width="300"
        SizeToContent="WidthAndHeight" CanResize="False"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="10">
        <TextBlock Margin="0 0 0 10" Text="{Binding OperationName}"/>
        <ProgressBar Margin="0 0 0 10" Height="20" IsIndeterminate="{Binding ProgressUnknown}" Value="{Binding ProgressValue}" Maximum="1" />
        <Button HorizontalAlignment="Center" Command="{Binding Cancel}" IsEnabled="{Binding CancelEnabled}">Cancel</Button>
    </StackPanel>
</Window>
